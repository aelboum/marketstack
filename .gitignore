# --- Secrets (mirrors saas-os docs/ADR/0012-secrets-management.md) --------
# .env is gitignored from the commit that introduces it. Never remove these
# lines to commit a real .env -- use .env.example for documented placeholders.
.env
.env.*
!.env.example
!frontend/.env.example

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.import_linter_cache/

# --- Node / frontend -----------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/*.tsbuildinfo
node_modules/

# --- Docker / local data ---------------------------------------------------
*.pid

# --- Editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# --- Local tooling state (not part of this repository's content) ----------
.claude/

# --- Login Service provisioned credential (docs/ADR/0017) ------------------
# scripts/provision_login_service_credential.py's own local-run output
# (private_key.pem + non-secret id files) -- the Docker Compose path
# writes these into a named volume instead, never this working tree, but
# a developer running the script directly on the host must not commit
# the private key it generates.
deploy/login-service/

# login-service/tests/conftest.py regenerates this throwaway RSA test key
# on demand (never registered with any real ZITADEL instance) -- a local
# pytest fixture artifact, not source, never committed.
login-service/tests/_test_private_key.pem
