# Copy this file to .env and fill in local-only values. .env is
# gitignored -- never commit a real secret (docs/SECURITY-PRIVACY.md).
# Only the variables this product's Phase 1 code paths actually read are
# listed here -- see docs/ROADMAP.md for what each phase adds.

# --- Local Docker build: private saas-os dependency ------------------------
# Required only to `docker compose build`/`up --build` locally -- the
# backend/zitadel-bootstrap/temporal-worker images clone the pinned
# saas-os commit during `pip install`, and that repo is private. Supply a
# GitHub token with read access to aelboum/saas-os (a personal access
# token is enough; no scopes beyond that repo's contents are needed).
# Never commit a real value here. Docker never receives this as a build
# ARG or a container ENV -- docker-compose.yml's own `secrets:` block
# reads it from this variable and mounts it as a BuildKit secret
# (`--mount=type=secret`, Dockerfile), so it never lands in an image
# layer or a running container's environment.
SAAS_OS_PAT=

# --- Runtime posture (required -- infra.secrets refuses to default this) --
ENVIRONMENT=development

# --- Database: two distinct roles, one physical database ------------------
# POSTGRES_USER/PASSWORD: the privileged bootstrap/migration role.
# APP_DB_USER/PASSWORD: the restricted runtime role (created by
# deploy/db-init/01-create-app-role.sh). Never the same role.
POSTGRES_USER=product
POSTGRES_PASSWORD=changeme
POSTGRES_DB=product
APP_DB_USER=product_app
APP_DB_PASSWORD=changeme_app
DATABASE_URL=postgresql+psycopg://product_app:changeme_app@db:5432/product
MIGRATIONS_DATABASE_URL=postgresql+psycopg://product:changeme@db:5432/product

# --- Redis (required by SaaS-OS Core at import time -- rate limiting, ----
# session/job-registration plumbing -- even though this product has not
# yet defined a background job of its own)
REDIS_URL=redis://redis:6379/0

# --- Temporal (docs/ROADMAP.md Phase 10.3's own durable-execution ---------
# infrastructure spike, docs/ADR/0007-automation-execution-substrate.md).
# Read directly from the environment, never through infra.secrets -- a
# plain host:port carries no credential
# (product/automation/durable/config.py's own docstring). Only
# `product/automation/durable/worker.py` (a separate, dedicated process,
# docker-compose.yml's own `temporal-worker` service) and a durable-
# adapter client/test ever read this; ordinary API startup does not, so
# leaving it unset does not stop the rest of this product from working.
TEMPORAL_ADDRESS=temporal:7233

# --- OIDC -- required for /auth/login to actually authenticate; the app ---
# itself builds and /healthz responds without these being real. Local
# development points at the local self-hosted ZITADEL docker-compose.yml
# runs (see "Local identity (ZITADEL)" below) -- no external/cloud OIDC
# provider or hosted tenant is needed.
OIDC_ISSUER_URL=http://zitadel.localhost:8081
# Filled in after `docker compose up`, from `docker compose logs
# zitadel-bootstrap` -- see "Local identity (ZITADEL)" below.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# ADR-0024 (saas-os's reusable `infra.edge` single-origin application
# runtime): the one browser-visible origin. The OIDC callback
# (<PUBLIC_APP_ORIGIN>/auth/callback) is *derived* from this, not
# configured separately -- see api/auth/config.py's own docstring (the
# installed saas-os dependency). Leave OIDC_REDIRECT_URI below empty;
# set it only for a deployment whose callback is genuinely not on this
# origin (setting both to disagreeing values is a fail-closed error).
PUBLIC_APP_ORIGIN=http://localhost:8080
OIDC_REDIRECT_URI=
# Same-origin relative path only (api/auth/config.py rejects an absolute
# URL) -- "/" is now served by the frontend, not the backend, because the
# `edge` service (below) routes everything except /auth, /v1, /healthz,
# /readyz to it. See frontend/app/page.tsx for the authenticated-vs-public
# handoff at that path.
AUTH_POST_LOGIN_PATH=/
AUTH_COOKIE_NAME=product_session
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
PUBLIC_DOMAIN=localhost

# --- Local single-origin edge (ADR-0024) -----------------------------------
# A minimal Caddy reverse proxy, emitted by the installed saas-os
# dependency's own `saas-os-edge-config` console script into
# deploy/caddy/Caddyfile.local (this project's own copy to maintain, never
# SaaS-OS source -- ADR-0015 rules 9/10). Routes /auth, /v1, /healthz,
# /readyz to `backend`, everything else to `frontend` -- so the browser
# only ever talks to one local origin. PUBLIC_APP_ORIGIN above and
# NEXT_PUBLIC_API_URL below both point at it, never at :8000/:3000
# directly. See docker-compose.yml's `edge` service.
EDGE_LOCAL_PORT=8080
# Read at Docker *build* time (Next.js NEXT_PUBLIC_* convention -- inlined
# into the client bundle, never a secret) via frontend/Dockerfile's build
# ARG, passed through by docker-compose.yml's `frontend.build.args`.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Local identity (ZITADEL) -- saas-os dependency's own local-development
# topology (saas-os docs/LOCAL-IDENTITY.md, "Downstream product
# development"); this product's docker-compose.yml declares the
# zitadel/zitadel-db/zitadel-bootstrap services, but the bootstrap tool
# itself (`saas-os-local-identity`) runs from the installed `saas-os`
# dependency -- no SaaS-OS Python source is copied into this repository.
# Names below are this product's own neutral technical identifier
# (docs/ADR/0001-naming-and-identifier-neutrality.md), never the temporary
# repository name.
OIDC_LOCAL_PROJECT_NAME=product
OIDC_LOCAL_APPLICATION_NAME=product-backend
ZITADEL_LOCAL_PORT=8081
# Exactly 32 characters -- `openssl rand -hex 16` produces one.
ZITADEL_LOCAL_MASTERKEY=changeme_32_char_local_masterkey
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=changeme_zitadel_db
ZITADEL_DB_NAME=zitadel
# The local ZITADEL admin console login (http://localhost:8081/ui/console)
# -- local-only, never used by this product's own OIDC flow.
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=changeme_zitadel_admin
ZITADEL_FIRSTINSTANCE_ADMIN_EMAIL=admin@product.local

# --- CORS (docs/ROADMAP.md UI Track, UI-1) -- comma-separated browser -----
# origin(s) allowed to make credentialed cross-origin requests. Through
# the `edge` service (above), the browser only ever sees one origin, so
# this middleware is not exercised on that path; kept for the alternate
# workflow of running `npm run dev` directly against the backend without
# the edge (frontend's own dev server on :3000, a different origin from
# backend :8000 in that case). Unset/empty means no origin is allowed,
# never "*" (product/api/main.py's _frontend_origins()).
FRONTEND_ORIGINS=http://localhost:3000
